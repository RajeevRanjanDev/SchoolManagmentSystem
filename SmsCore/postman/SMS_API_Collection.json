{
  "info": {
    "name": "School Management System API",
    "description": "Complete REST API collection for the Multi-Tenant SMS platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8080" },
    { "key": "accessToken",  "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@sms.com\",\n  \"password\": \"Admin@1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "pm.collectionVariables.set('accessToken',  res.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', res.data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Schools",
      "item": [
        {
          "name": "Create School",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/schools",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Green Valley School\",\n  \"code\": \"GVS-001\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"country\": \"India\",\n  \"email\": \"info@gvs.edu\",\n  \"currentAcademicYear\": \"2024-2025\"\n}"
            }
          }
        },
        {
          "name": "List Schools",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/schools"
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "Create Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Riya\",\n  \"lastName\": \"Sharma\",\n  \"admissionNumber\": \"ADM-2024-001\",\n  \"gender\": \"FEMALE\",\n  \"dateOfBirth\": \"2010-05-14\",\n  \"bloodGroup\": \"O+\",\n  \"admissionDate\": \"2024-04-01\"\n}"
            }
          }
        },
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/students?page=0&size=20"
          }
        },
        {
          "name": "Get Student by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/students/1"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Mark Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/attendance/mark",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sectionId\": 1,\n  \"attendanceDate\": \"2024-11-12\",\n  \"entries\": [\n    { \"studentId\": 1, \"status\": \"PRESENT\" },\n    { \"studentId\": 2, \"status\": \"ABSENT\", \"remarks\": \"Sick leave\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "Get Student Attendance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/attendance/student/1?from=2024-11-01&to=2024-11-30"
          }
        },
        {
          "name": "Get Attendance Percentage",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/attendance/student/1/percentage?from=2024-11-01&to=2024-11-30"
          }
        }
      ]
    },
    {
      "name": "Fees",
      "item": [
        {
          "name": "Get Student Fees",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/fees/student/1"
          }
        },
        {
          "name": "Record Fee Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/fees/payment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"feeId\": 1,\n  \"amountPaid\": 5000.00,\n  \"paymentMethod\": \"ONLINE\",\n  \"transactionReference\": \"TXN-12345\"\n}"
            }
          }
        },
        {
          "name": "Fee History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/fees/history/student/1"
          }
        }
      ]
    },
    {
      "name": "Bus Tracking",
      "item": [
        {
          "name": "Get Live Location",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/bus/live-location/1"
          }
        },
        {
          "name": "Update Bus Location",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/bus/location",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"latitude\": 28.6139,\n  \"longitude\": 77.2090,\n  \"speedKmh\": 35.5\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Library",
      "item": [
        {
          "name": "List Books",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/library/books"
          }
        },
        {
          "name": "Issue Book",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/library/issue?bookId=1&studentId=1&dueDate=2024-12-01"
          }
        },
        {
          "name": "Return Book",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/library/return/1"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/dashboard"
          }
        }
      ]
    }
  ]
}
